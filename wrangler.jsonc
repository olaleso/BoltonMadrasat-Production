{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "bolton-madrasat",
	"main": "vinext/server/app-router-entry",
	"compatibility_date": "2026-05-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bolton-madrasat",
			"database_id": "2123d5c6-014c-42eb-86fd-d9d15a204e80",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"NEXT_PUBLIC_APP_NAME": "BNMC Madrasah"
	},
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"bucket_name": "bnmc-media",
			"binding": "MEDIA"
		}
	]
}
